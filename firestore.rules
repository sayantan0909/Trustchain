rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: Check if the user is an authorized admin
    function isAdmin() {
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // Admin authorization document: each admin can read their own
    match /admins/{adminId} {
      allow read: if request.auth != null && request.auth.uid == adminId;
      allow write: if false; // Only manageable via Firebase Console
    }

    // Collections that Admins can manage
    match /users/{userId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /complaints/{complaintId} {
      allow read: if true; // Public can read for platform transparency
      allow create: if true; // Any wallet user can report (handled by frontend logic)
      allow update: if isAdmin(); // Only admins can moderate/resolve
      allow delete: if false;
    }

    match /escrows/{escrowId} {
      allow read: if true; // Public can read for platform transparency
      allow create: if true; // Any wallet user can create
      allow update: if true; // Updates handled by wallet logic
      allow delete: if false;
    }
    
    match /milestones/{milestoneId} {
      allow read: if true;
      allow write: if true;
    }

    match /wallet_flags/{flagId} {
      allow read: if true; // Public needs to read to see if a wallet is banned
      allow write: if isAdmin(); // Only admins can ban/flag wallets
    }

    match /admin_logs/{logId} {
      allow read: if isAdmin(); // Only admins can see audit trail
      allow create: if isAdmin(); // Log entry created by admin action
      allow update, delete: if false; // Logs are immutable
    }

    // Default: Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
