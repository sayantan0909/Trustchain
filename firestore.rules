rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Admin Authentication Rule
    // Each admin can only read their own authorization document
    match /admins/{adminId} {
      allow read: if request.auth != null
                  && request.auth.uid == adminId;
      allow write: if false; // Admins created only via Firebase Console
    }

    // Default: Deny all other access for the Auth Module
    match /{document=**} {
      allow read, write: if false;
    }
    
    // NOTE: If you decide to re-enable other platform features (Escrows, Flags, etc.),
    // you would add those rules here. For now, this is strictly secured.
  }
}
